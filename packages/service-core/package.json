{
  "name": "@gip/service-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared, non-secret building blocks for the three Fastify services: error envelope, pagination, config validation, database client and health route.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./pagination": "./src/pagination.ts",
    "./config": "./src/config.ts",
    "./db": "./src/db.ts",
    "./health": "./src/health.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3",
    "zod": "^4.1.12",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
