# The portfolio's public configuration.
#
# VITE_* variables are PUBLIC — they are bundled into the JavaScript that
# every visitor downloads. Only put URLs here. A database URL, a JWT secret
# or any other credential in a VITE_* variable would be readable by anyone who
# opens the page source.
#
# The three API base URLs are the deployed origins of the three services.
# They are origins only: no trailing slash, no path.
#
# NOTE: these are the REAL addresses. The service names on Render do not
# always match the challenge they serve — the Lost & Found API is called
# "gip-challenges", not "gip-lost-found-api".

VITE_LOST_FOUND_API_URL=https://gip-challenges.onrender.com
VITE_AUTH_API_URL=https://gip-auth-api.onrender.com
VITE_FLASH_SALE_API_URL=https://flash-sale-oopm.onrender.com

# For LOCAL testing, copy this file to .env.local and point the three URLs at
# the services running on this machine instead:
#
#   VITE_LOST_FOUND_API_URL=http://localhost:3001
#   VITE_AUTH_API_URL=http://localhost:3002
#   VITE_FLASH_SALE_API_URL=http://localhost:3003
#
# Vite reads .env.local automatically, and it is gitignored.
