# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the filled-in .env — it is gitignored.
# Only the *_example files are tracked.
# ---------------------------------------------------------------------------

# --- Local database -------------------------------------------------------
# If DATABASE_URL is unset, services start an embedded PostgreSQL automatically.
# Set it to use the docker-compose instance instead:
#   DATABASE_URL=postgres://gip:gip_local_dev_only@localhost:5433/gip
DATABASE_URL=

# Production is Neon. Use the pooled connection string for the deployed apps.
# PRODUCTION_DATABASE_URL=

# --- Ports ----------------------------------------------------------------
PORT=

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to call these APIs from a browser.
# Must be the exact deployed portfolio origin — preview domains change on
# every push and will silently break the allowlist.
CORS_ORIGINS=http://localhost:5173

# --- Auth service ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m

# --- Portfolio (VITE_* is PUBLIC — shipped to the browser) ----------------
# Only ever put public URLs here. A database URL, JWT secret or any other
# credential in a VITE_* variable is exposed to every visitor.
VITE_LOST_FOUND_API_URL=
VITE_AUTH_API_URL=
VITE_FLASH_SALE_API_URL=