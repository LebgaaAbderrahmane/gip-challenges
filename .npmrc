# pnpm configuration
# npm is broken on the development machine (missing transitive deps), so this
# repository uses pnpm workspaces instead. See docs/architecture.md.

auto-install-peers=true
strict-peer-dependencies=false

# The workspace changes shape as services are added, and pnpm then wants to
# rebuild the modules directory. Allow that without a TTY, so installs work
# the same in a terminal and in CI.
confirmModulesPurge=false

# Native deps (argon2, pg) must be built rather than linked from the store.
node-linker=isolated