# The Authentication API.
#
# Copy to .env and fill in. NEVER commit the filled-in .env.

NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# The database this service owns. It connects as the "auth_role" role, whose
# search_path points at the "auth" schema, so it has no access to the other
# services' schemas. This is the same arrangement as production.
#
# Do NOT connect as the superuser "gip" here: its search_path is "public",
# where none of this service's tables are, and every query would fail.
DATABASE_URL=postgres://auth_role:gip_local_dev_only@localhost:5433/gip

# The secret used to SIGN tokens and to verify them on the other services.
# All three services must have the SAME value, or every authenticated
# request fails with 401.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=gip-auth
JWT_AUDIENCE=gip
JWT_EXPIRES_IN=15m

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173
