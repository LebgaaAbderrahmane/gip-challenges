# The Lost & Found API.
#
# Copy to .env and fill in. NEVER commit the filled-in .env.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# The database this service owns. It connects as the "lost_found" role, which
# has no access to the other services' schemas.
DATABASE_URL=postgres://gip:gip_local_dev_only@localhost:5433/gip

# The secret used to VERIFY tokens issued by the auth service.
JWT_SECRET=
JWT_ISSUER=gip-auth
JWT_AUDIENCE=gip

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173
