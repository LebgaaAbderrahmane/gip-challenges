# The Lost & Found API.
#
# Copy to .env and fill in. NEVER commit the filled-in .env.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# The database this service owns. It connects as the "lost_found_role" role,
# whose search_path points at the "lost_found" schema, so it has no access to
# the other services' schemas. This is the same arrangement as production.
#
# Do NOT connect as the superuser "gip" here: its search_path is "public",
# where none of this service's tables are, and every query would fail.
DATABASE_URL=postgres://lost_found_role:gip_local_dev_only@localhost:5433/gip

# The secret used to VERIFY tokens issued by the auth service.
JWT_SECRET=
JWT_ISSUER=gip-auth
JWT_AUDIENCE=gip

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173
