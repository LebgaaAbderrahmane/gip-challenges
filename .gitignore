# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.vite/
*.tsbuildinfo

# Vanilla demo copies generated by scripts/sync-demos.mjs before dev/build.
# Regenerated on every run, so committing them would only create churn.
apps/portfolio/public/demos/

# Environment / secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# Database dumps and ad-hoc SQL
*.dump
docker-data/
pgdata/

# Schema and migration SQL IS tracked — these are source, not data.
# (Only dump output is ignored.)

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Test output
coverage/
.nyc_output/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
# Generated connection strings for the hosted services. Contains credentials.
.env.render
